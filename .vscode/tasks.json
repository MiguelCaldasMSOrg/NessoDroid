{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Android: Build Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": ["assembleDebug"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Android: Unit Tests",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": ["testDebugUnitTest"],
            "group": "test",
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Android: Lint",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": ["lintDebug"],
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Android: Build Signed Release APK",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": ["assembleRelease", "lintRelease", "--no-configuration-cache"],
            "problemMatcher": ["$gradle"]
        }
    ]
}